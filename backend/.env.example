# IMAP & SMTP Sunucu Bilgileri
IMAP_HOST=mail.domain.com
IMAP_PORT=993
IMAP_SECURE=true

SMTP_HOST=mail.domain.com
SMTP_PORT=465
SMTP_SECURE=true

# Kimlik Doğrulama Bilgileri
IMAP_USER=user@domain.com
IMAP_PASS=your_password

# Güvenlik ve Şifreleme
# Oturum token'larini (icinde IMAP kimlik bilgileri tasinir) sifreler.
# Rastgele uretin, ASLA git'e commit etmeyin:  openssl rand -base64 48
# Degistirildiginde acik oturumlar dusler, kullanicilar yeniden giris yapar.
ENCRYPTION_KEY=buraya_rastgele_uretilmis_guclu_bir_anahtar
PORT=3005
